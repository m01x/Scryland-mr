{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "oauth": {}
    }
  },
  "agent": {
    "backend": {
      "description": "Worker aislado del backend (app/api). Escribe solo dentro de app/api; shared/ y .spec/ son de solo lectura.",
      "mode": "all",
      "prompt": "{file:app/api/AGENTS.md}",
      "permission": {
        "edit": {
          "*": "deny",
          ".spec/*": "deny",
          "shared/*": "deny",
          "app/api/*": "allow",
          "app/api/.agents/*": "deny",
          "app/api/.claude/*": "deny"
        }
      }
    },
    "web": {
      "description": "Worker aislado del frontend (app/web). Escribe solo dentro de app/web; shared/, .spec/ y app/api/ son de solo lectura.",
      "mode": "all",
      "prompt": "{file:app/web/AGENTS.md}",
      "permission": {
        "edit": {
          "*": "deny",
          ".spec/*": "deny",
          "shared/*": "deny",
          "app/api/*": "deny",
          "app/web/*": "allow",
          "app/web/.agents/*": "deny",
          "app/web/.claude/*": "deny"
        }
      }
    }
  }
}